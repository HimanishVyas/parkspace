# Copy to .env and adjust. Never commit the real .env.

# ---- General ----------------------------------------------------------------
APP_NAME=ParkSpace
ENVIRONMENT=development           # development | test | production
DEBUG=true
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:18080
# JSON array of allowed browser origins.
CORS_ORIGINS=["http://localhost:5173","http://localhost:18080"]
# Availability rules and booking times are interpreted in this timezone.
TIMEZONE=Asia/Kolkata

# ---- Database ---------------------------------------------------------------
# Inside docker-compose this is overridden to point at the `db` service.
DATABASE_URL=postgresql+asyncpg://parking:parking@localhost:55432/parking
DB_ECHO=false

# ---- Redis (optional) -------------------------------------------------------
# Empty falls back to in-process rate limiting (fine for a single instance).
REDIS_URL=

# ---- Auth -------------------------------------------------------------------
# REQUIRED in production: generate with `openssl rand -hex 32`.
JWT_SECRET=change-me-in-env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30

# ---- Storage ----------------------------------------------------------------
STORAGE_BACKEND=local
MEDIA_ROOT=media
MEDIA_URL=/media
MAX_UPLOAD_BYTES=5242880

# ---- Payments ---------------------------------------------------------------
# `mock` simulates a gateway end-to-end without leaving the machine.
PAYMENT_GATEWAY=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
MOCK_GATEWAY_SECRET=mock-gateway-secret

# ---- Email ------------------------------------------------------------------
EMAIL_BACKEND=console             # console | smtp
EMAIL_FROM=ParkSpace <no-reply@parkspace.app>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false

# ---- Geocoding --------------------------------------------------------------
GEOCODER_URL=https://nominatim.openstreetmap.org/search
GEOCODER_USER_AGENT=parkspace-pilot/1.0

# ---- Background maintenance -------------------------------------------------
MAINTENANCE_ENABLED=true
MAINTENANCE_INTERVAL_SECONDS=60

# ---- Rate limiting ----------------------------------------------------------
RATE_LIMIT_ENABLED=true

# ---- Seed admin (created by `python -m app.cli seed`) -----------------------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin12345
